# Export Python variables in your shell; the Python service does not load .env.
# Copy frontend variables into web/.env.local.
NEXT_PUBLIC_ENGINE_API_URL=http://localhost:8000
ENGINE_API_URL=http://localhost:8000
# Demo uses a synthetic store and history, isolated from the private corpus.
PESE_PROFILE=demo
PESE_STORAGE_BACKEND=local
# Optional: choose a new empty runtime directory you control.
# PESE_DATA_DIR=
# Legacy personal store: PESE_PROFILE=private (default when unset).

# Cloud storage requires explicit selection. Ambient credentials alone do not
# activate Firebase. Never put credentials or real project IDs in this file.
# PESE_STORAGE_BACKEND=firestore
# FIRESTORE_EMULATOR_HOST=localhost:8080
# GOOGLE_APPLICATION_CREDENTIALS=
# PESE Google Drive Sync Foundation (OAuth 2.0 Desktop PKCE)
# PESE uses drive.appdata scope strictly for versioned Brain snapshots.
# Packaged desktop: place Google Desktop client JSON at
# %LOCALAPPDATA%\ManiacSoftwares\PESE\google-oauth-config.json
# The WPF host intentionally removes PESE_* environment variables.
# Source-only development may use PESE_GOOGLE_CLIENT_ID / PESE_GOOGLE_CLIENT_SECRET.
# Never commit the client configuration or token storage.

PESE_PREWARM_QA=0
